{
  "name": "SM-DA-server",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "egg": {
    "declarations": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "egg": "^3.17.5",
    "egg-cors": "^3.0.1",
    "egg-mongoose": "^4.0.1",
    "egg-scripts": "2",
    "egg-validate": "^2.0.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "egg-bin": "6",
    "egg-mock": "5",
    "eslint": "^8.57.1",
    "eslint-config-egg": "^14.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "koa-session": "7.0.2",
